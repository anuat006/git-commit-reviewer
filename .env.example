# Copy this file to ".env" (same folder) and fill in your values. NEVER commit ".env".
#   PowerShell:  copy .env.example .env

# Dedicated issue-tracker repo where findings are filed (URL or owner/name)
ISSUE_REPO=https://github.com/anuat006/issue-tracker

# Token the MCP server uses to create issues in the test repo.
#   fine-grained token: "Issues: Read and write" on that one repository (recommended)
#   or quick local option: run `gh auth token` and paste the output
GITHUB_TOKEN=

# Only for --model copilot (GitHub Models). Separate token from the issue token:
# fine-grained PAT with "Models: read" permission.
GITHUB_MODELS_TOKEN=

# Seconds the human approval stays valid (default 120)
APPROVAL_TTL=120

# Optional
# REVIEWER_LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING
# AUDIT_LOG=audit_log.jsonl
# REVIEWER_MODEL=llama3.1                 # model name for the chosen provider (ollama list)
# OLLAMA_HOST=http://localhost:11434
# GITLEAKS_BIN=C:\tools\gitleaks\gitleaks.exe   # only if gitleaks is not on PATH
